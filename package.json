{
  "name": "prisma-ama",
  "version": "1.0.0",
  "scripts": {
    "dev": "next",
    "prisma:generate:library": "PRISMA_CLIENT_ENGINE_TYPE='library' prisma generate",
    "prisma:generate:dataproxy": "PRISMA_CLIENT_ENGINE_TYPE='dataproxy' prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src --fix",
    "husky:install": "husky install",
    "db:push": "prisma db push",
    "prod:db:seed": "dotenv -- sh -c 'DATABASE_URL=\"$MIGRATE_DATABASE_URL\" prisma db seed'"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "^6.15.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "0.5.16",
    "@tanstack/react-query": "^5.85.6",
    "@tanstack/react-query-devtools": "^5.85.6",
    "@tippy.js/react": "3.1.1",
    "@typescript-eslint/eslint-plugin": "8.41.0",
    "cloudinary": "1.27.1",
    "cookie": "0.4.1",
    "next": "15.5.9",
    "next-auth": "4.24.11",
    "next-seo": "4.28.1",
    "prismjs": "1.27.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-feather": "2.0.10",
    "react-hot-toast": "2.6.0",
    "react-linkify": "1.0.0-alpha",
    "react-markdown": "10.1.0",
    "string-replace-to-array": "2.1.1",
    "timeago.js": "4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@typescript-eslint/parser": "8.41.0",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "4.0.0",
    "eslint": "9.34.0",
    "eslint-config-next": "^15.5.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-mdx": "3.6.2",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "globals": "^16.3.0",
    "lint-staged": "11.2.3",
    "postcss": "8.5.6",
    "postcss-import": "16.1.1",
    "postcss-preset-env": "10.3.1",
    "prettier": "3.6.2",
    "prettier-eslint": "16.4.2",
    "prisma": "^6.15.0",
    "stylelint-config-recommended": "5.0.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.2",
    "typescript-eslint-parser": "22.0.0",
    "webpack": "5.58.1"
  },
  "lint-staged": {
    "*.+(ts|tsx)": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "pre-commit": "lint:staged && generate",
  "license": "MIT"
}
